{
  "name": "learning-app",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:material": "node scripts/check-material.ts",
    "snapshot:material": "node scripts/snapshot-material.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.15.0",
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.8",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@vue/compiler-dom": "^3.5.30",
    "codemirror": "^6.0.1",
    "cors": "^2.8.5",
    "esbuild": "^0.27.4",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.0",
    "pug": "^3.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/pug": "^2.0.10",
    "concurrently": "^8.2.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
